{
    "name": "chathop",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Forwards messages from one chat to others. Each destination gets its own filters and caption rules. Runs on Telegram Serverless — no host, no database.",
    "keywords": [
        "telegram",
        "telegram-bot",
        "telegram-forwarder",
        "telegram-forward-bot",
        "message-forwarding",
        "forward-messages",
        "telegram-channel",
        "auto-forward",
        "telegram-mini-app",
        "telegram-serverless",
        "serverless",
        "svelte"
    ],
    "homepage": "https://github.com/viperadnan-git/chathop",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/viperadnan-git/chathop.git"
    },
    "bugs": {
        "url": "https://github.com/viperadnan-git/chathop/issues"
    },
    "license": "GPL-3.0-or-later",
    "author": "Adnan Ahmad",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "biome check",
        "format": "biome check --write",
        "deploy": "vite build && tgcloud push && tgcloud run endpoints/setup '{}' --ctx '{}'",
        "status": "tgcloud status",
        "run": "tgcloud run",
        "check": "biome ci && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && bun test/check.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tgcloud/cli": "^0.2.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^24.13.3",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "~6.0.2",
        "vite": "^8.3.0"
    },
    "nizm": {
        "hooks": {
            "biome": {
                "cmd": "bunx biome check --write --no-errors-on-unmatched {staged_files}",
                "glob": "*.{js,jsx,ts,tsx,mjs,cjs,svelte,json,jsonc,css}"
            }
        }
    }
}
